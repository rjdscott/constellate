# Copy to .env (gitignored) — only needed for the context-plane demo's API
# driver. Everything else runs with no secrets at all.
#
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/ → API keys.
ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides (defaults shown; all local, none secret) ---
# OLLAMA_URL=http://localhost:11434
# PLATFORM=lyra
# ORION_DSN=postgresql://constellate:constellate@localhost:15432/constellate
# HYDRA_DSN=postgresql://constellate:constellate@localhost:15433/constellate
# HYDRA_QDRANT_URL=http://localhost:16333
# HYDRA_MEMGRAPH_URI=bolt://localhost:17687
